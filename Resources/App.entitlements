<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shares the saved cities with the widget (widgets set to "Your Two Degrees cities"). The team ID
         prefix lets a Developer ID app use the group without a provisioning profile. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>2XV97FZ86G.com.bradcowdrey.twodegrees</string>
    </array>
</dict>
</plist>
