<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app's saved cities, shared with the widget (widgets using Two Degrees' cities). -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.bradcowdrey.twodegrees</string>
    </array>
</dict>
</plist>
